{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenICam Studio",
  "version": "0.1.0",
  "identifier": "com.vitalyvorobyev.genicam-studio",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../ui/genicam-studio-ui dev:wasm",
    "beforeBuildCommand": "bun run --cwd ../../ui/genicam-studio-ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../ui/genicam-studio-ui/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "GenICam Studio",
        "width": 1024,
        "height": 768
      }
    ]
  }
}
