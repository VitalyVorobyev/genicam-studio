<?xml version="1.0" encoding="UTF-8"?>
<RegisterDescription>
  <Category Name="Root">
    <DisplayName>Root</DisplayName>
    <pFeature>ExposureTime</pFeature>
    <pFeature>PixelFormat</pFeature>
    <pFeature>AcquisitionEnable</pFeature>
    <pFeature>TriggerSoftware</pFeature>
    <pFeature>MagicCalc</pFeature>
  </Category>
  <Integer Name="ExposureTime">
    <DisplayName>Exposure Time</DisplayName>
    <Min>10</Min>
    <Max>1000</Max>
    <Inc>5</Inc>
    <Unit>us</Unit>
  </Integer>
  <Enumeration Name="PixelFormat">
    <DisplayName>Pixel Format</DisplayName>
    <EnumEntry Name="Mono8">
      <Value>0</Value>
      <DisplayName>Mono 8</DisplayName>
    </EnumEntry>
    <EnumEntry Name="Mono12">
      <Value>1</Value>
      <DisplayName>Mono 12</DisplayName>
    </EnumEntry>
    <EnumEntry Name="RGB8">
      <Value>2</Value>
      <DisplayName>RGB 8</DisplayName>
    </EnumEntry>
  </Enumeration>
  <Boolean Name="AcquisitionEnable">
    <DisplayName>Acquisition Enable</DisplayName>
  </Boolean>
  <Command Name="TriggerSoftware">
    <DisplayName>Trigger Software</DisplayName>
  </Command>
  <SwissKnife Name="MagicCalc">
    <DisplayName>Magic Calc</DisplayName>
    <Formula>ExposureTime * 2</Formula>
  </SwissKnife>
</RegisterDescription>
